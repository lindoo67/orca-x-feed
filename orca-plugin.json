{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "x-feed",
  "name": "X Feed",
  "version": "0.2.0",
  "description": "在 Orca 侧边栏浏览 X 的热议话题、搜索结果与用户时间线。",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "main": "worker.mjs",
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "深色卡片上的白色 X 标志，右侧是四条推文列表的示意图"
  },
  "author": {
    "name": "LinDoo",
    "url": "https://github.com/lindoo67"
  },
  "repository": "https://github.com/lindoo67/orca-x-feed",
  "contributes": {
    "panels": [
      {
        "id": "feed",
        "title": "X Feed",
        "icon": "globe",
        "entry": "panel/index.html",
        "ui": "html"
      }
    ],
    "settings": [
      {
        "key": "mode",
        "title": "默认视图",
        "description": "打开 X Feed 时显示的视图。",
        "type": "string",
        "default": "trending",
        "enum": ["trending", "search", "profile"],
        "enumLabels": ["热议", "搜索", "用户"]
      },
      {
        "key": "apiBase",
        "title": "API 基址",
        "description": "抓取 X 内容的后端。留空则使用内置的公开代理端点。",
        "type": "string",
        "default": "https://api.fxtwitter.com",
        "maxLength": 2048,
        "placeholder": "https://api.fxtwitter.com"
      },
      {
        "key": "refreshMinutes",
        "title": "自动刷新间隔（分钟）",
        "description": "0 表示关闭自动刷新。",
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 120
      }
    ]
  },
  "capabilities": [
    { "kind": "settings:own" },
    { "kind": "secrets:own" },
    { "kind": "storage:own" }
  ]
}
