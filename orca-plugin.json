{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "x-feed",
  "name": "X Feed",
  "version": "0.2.0",
  "description": "在 Orca 侧边栏查看单条 X 推文和用户资料，附一个本地收藏列表。",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker.mjs",
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "深色卡片上的白色 X 标志，右侧是四条推文列表的示意图"
  },
  "author": {
    "name": "LinDoo",
    "url": "https://github.com/lindoo67"
  },
  "repository": "https://github.com/lindoo67/orca-x-feed",
  "contributes": {
    "panels": [
      {
        "id": "feed",
        "title": "X Feed",
        "icon": "globe",
        "entry": "panel/index.html",
        "ui": "html"
      }
    ],
    "settings": [
      {
        "key": "apiBase",
        "title": "API 基址",
        "description": "解析推文的后端，必须是 https。留空则使用 api.fxtwitter.com。",
        "type": "string",
        "default": "https://api.fxtwitter.com",
        "maxLength": 2048,
        "placeholder": "https://api.fxtwitter.com"
      }
    ]
  },
  "capabilities": [
    { "kind": "settings:own" },
    { "kind": "storage:own" }
  ]
}
