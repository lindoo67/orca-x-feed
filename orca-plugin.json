{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "x-feed",
  "name": "X Feed",
  "version": "0.1.0",
  "description": "Browse X (Twitter) trends, profiles, and search results right in your Orca sidebar.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker.mjs",
  "contributes": {
    "panels": [
      {
        "id": "x-feed",
        "title": "X Feed",
        "icon": "share",
        "entry": "panel/index.html",
        "ui": "html"
      }
    ],
    "settings": [
      {
        "key": "mode",
        "title": "Default view",
        "description": "What to show when you open X Feed.",
        "type": "string",
        "default": "trending",
        "enum": ["trending", "search", "profile"],
        "enumLabels": ["Trending", "Search", "Profile"]
      },
      {
        "key": "apiBase",
        "title": "API Base URL",
        "description": "The backend to use. vxtwitter is free and requires no token. For private/timed tweets you need a Bearer token backend.",
        "type": "string",
        "default": "https://api.vxtwitter.com",
        "placeholder": "https://api.vxtwitter.com"
      },
      {
        "key": "bearerToken",
        "title": "X Bearer Token",
        "description": "Optional: a Bearer token from an X Developer app for authenticated requests.",
        "type": "string",
        "maxLength": 512
      },
      {
        "key": "autoRefresh",
        "title": "Auto-refresh interval",
        "description": "How often to refresh the feed (0 = off).",
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 300
      }
    ]
  },
  "capabilities": [
    {
      "kind": "settings:own"
    },
    {
      "kind": "network:origin:https://api.vxtwitter.com"
    },
    {
      "kind": "network:origin:https://api.fxtwitter.com"
    },
    {
      "kind": "network:origin:https://x.com"
    }
  ],
  "author": {
    "name": "LinDoo",
    "url": "https://github.com/LinDoo"
  },
  "repository": "https://github.com/LinDoo/orca-x-feed"
}
